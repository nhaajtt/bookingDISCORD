{
  "name": "bookingDISCORD",
  "version": "1.0.0-rc.1",
  "description": "Discord bot that runs a book-a-friend server: bookings, payOS and Stripe payments, a prepaid wallet and an honest payout ledger",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "deploy-commands": "node src/deploy-commands.js",
