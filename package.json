    "restore": "node --disable-warning=ExperimentalWarning scripts/restore.js",
    "check": "node scripts/check.js",
    "license": "node --disable-warning=ExperimentalWarning scripts/license.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "author": "nhaajt"
