DISCORD_TOKEN=
CLIENT_ID=
# The one server this bot runs (one bot instance per booking server). Not needed when MULTI_TENANT=true.
GUILD_ID=

# Discord user IDs (comma separated) who always count as owner, whatever their roles. Single-server mode only.
OWNER_IDS=

# ---- payments: payOS and/or Stripe. A gateway is on when its keys are set.
# payOS keys of the owner's own channel (https://payos.vn). All three are needed.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Stripe secret key (sk_live_... or sk_test_...). Stripe payments are refunded automatically; payOS cannot send money back.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Which gateway new payments use when more than one is on: payos, stripe or manual (bank transfer; empty = payos, stripe, then manual)
PAYMENT_PROVIDER=
# Where the customer is sent after paying or cancelling
RETURN_URL=https://discord.com/channels/@me

# The time zone availability and reminders are read in
TIMEZONE=Asia/Ho_Chi_Minh

# ---- web server (off unless WEB_PORT is set): payOS webhook, owner dashboard, metrics
WEB_PORT=
WEB_HOST=0.0.0.0
# The address people reach the server at, for the links the bot shows, e.g. https://booking.example.com
WEB_PUBLIC_URL=
# A fixed dashboard token (otherwise the owner makes one with /admin bang-dieu-khien)
DASHBOARD_TOKEN=
# Token for /metrics (empty = only localhost may read it)
METRICS_TOKEN=

# ---- public booking site (see docs/web.md); the /api routes answer 503 until all three are set
# OAuth2 client secret of the Discord application (Developer Portal, OAuth2)
DISCORD_CLIENT_SECRET=
# Random string of 32+ characters that signs the login cookies, e.g. the output of: openssl rand -base64 48
SESSION_SECRET=
# The origin the browser sees: the site's own address, e.g. https://book.example.com (no path, no trailing slash)
WEB_SITE_URL=
# Optional invite link to the Discord server, shown to visitors who are not members yet
WEB_DISCORD_INVITE=

# ---- many servers in one bot (see README, "Many servers")
MULTI_TENANT=false
# With MULTI_TENANT=true every server needs a license; set false to serve everyone
LICENSE_REQUIRED=true

# ---- optional
DATA_DIR=data
ALERT_WEBHOOK_URL=
# debug, info, warn or error; LOG_FORMAT=json writes one JSON object per line
LOG_LEVEL=info
LOG_FORMAT=
# Set to 1 to add stack traces to error lines
LOG_STACK=
